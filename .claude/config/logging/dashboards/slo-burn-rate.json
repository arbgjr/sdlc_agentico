{
  "__comment": "SLO burn-rate dashboard for SDLC Agêntico. Panels map 1:1 to entries in .claude/config/slos.yml. Each burn-rate panel uses the dual-window (short/long) pattern from Google SRE workbook to reduce alert flapping. Thresholds here MUST match slos.yml; the evals/settings-lint runner should assert this in a future iteration.",
  "__version": "1.0",
  "__owner": "observability-engineer",
  "title": "SDLC Agêntico — SLO Burn Rate",
  "uid": "sdlc-slo-burn-rate",
  "tags": ["sdlc", "slo", "burn-rate"],
  "schemaVersion": 38,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource_prom",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      },
      {
        "name": "datasource_loki",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "loki" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Gate decision latency — P99 vs SLO (8s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(sdlc_gate_decision_seconds_bucket[5m]))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 8 }
            ]
          }
        }
      },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "title": "Gate availability — rolling 7d",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "targets": [
        {
          "expr": "sum(rate(sdlc_gate_runs_success_total[7d])) / sum(rate(sdlc_gate_runs_total[7d]))",
          "legendFormat": "availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.999 },
              { "color": "green", "value": 0.9995 }
            ]
          }
        }
      },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "title": "Copilot task wallclock — P95 vs SLO (90min)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(sdlc_copilot_task_wallclock_seconds_bucket[1h])) / 60",
          "legendFormat": "P95 (minutes)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "title": "Copilot review rejection rate — target <20%",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "targets": [
        {
          "expr": "sum(rate(sdlc_copilot_prs_rejected_total[1d])) / sum(rate(sdlc_copilot_prs_reviewed_total[1d]))",
          "legendFormat": "rejection rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 5,
      "title": "Burn rate — fast window (1h/5m, factor 14.4)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "targets": [
        {
          "expr": "(1 - (sum(rate(sdlc_gate_runs_success_total[1h])) / sum(rate(sdlc_gate_runs_total[1h])))) / (1 - 0.999)",
          "legendFormat": "gate_evaluator burn (1h)"
        },
        {
          "expr": "(1 - (sum(rate(sdlc_gate_runs_success_total[5m])) / sum(rate(sdlc_gate_runs_total[5m])))) / (1 - 0.999)",
          "legendFormat": "gate_evaluator burn (5m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    },
    {
      "id": 6,
      "title": "Resilience circuits open — daily minutes (target <5)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "targets": [
        {
          "expr": "sum(increase(sdlc_resilience_circuit_open_seconds_total[1d])) / 60",
          "legendFormat": "minutes open / 24h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 6 }
    },
    {
      "id": 7,
      "title": "Clarify rounds to approval — P95 (target <=3)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(sdlc_clarify_rounds_bucket[7d]))",
          "legendFormat": "P95 rounds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 4 }
            ]
          }
        }
      },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 6 }
    }
  ]
}
